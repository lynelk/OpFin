APP_NAME=OpFin
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Kampala
APP_URL=http://localhost
OPFIN_ENABLE_DEMO_ROUTES=false

# Dormant community finance / SACCO foundation. Keep closed until formal activation.
OPFIN_COMMUNITY_FINANCE_MODE=dormant
OPFIN_COMMUNITY_FINANCE_LIVE_ENABLED=false
OPFIN_SACCO_CORE_ENABLED=false
OPFIN_COMMUNITY_FINANCE_PUBLIC_ROUTES_ENABLED=false

# Production credit policy. DSR = estimated monthly obligation / verified monthly income * 100.
OPFIN_MAX_DSR_PERCENT=35
# Positive-only verified employer behaviour may add a capped benefit. Missing/negative data is neutral.
OPFIN_EMPLOYMENT_BEHAVIOUR_MAX_UPLIFT=5
# Local/testing may use false. Production boot requires true: every governed credit offer must have approved funding provenance.
OPFIN_REQUIRE_FUNDING_POOL_ASSIGNMENT=false

# Third-party service routing. auto prefers Cito when configured and otherwise uses the direct adapter.
# A failed/ambiguous Cito request never silently triggers a second paid provider enquiry.
OPFIN_EXTERNAL_SERVICE_ROUTE=auto
OPFIN_DIRECT_PROVIDER_FALLBACK_ENABLED=true
# Legacy origination is compatibility-only and must remain disabled in production.
OPFIN_ENABLE_LEGACY_LOAN_ORIGINATION=false

# CPay v2 is the preferred production money-movement route, not an availability dependency.
# Use mock only in local/testing. A direct production adapter requires an installed adapter class,
# genuine credentials/provider contract, reconciliation semantics and explicit certification.
MOBILE_MONEY_PROVIDER=mock
MOBILE_MONEY_CURRENCY=UGX
CPAY_BASE_URL=
CPAY_MERCHANT_NUMBER=
CPAY_MERCHANT_ID=
# PEM value may be provided with literal \n characters; the adapter normalizes them at runtime.
CPAY_PRIVATE_KEY=
CPAY_CALLBACK_URL=
CPAY_CALLBACK_SECRET=
CPAY_CALLBACK_REPLAY_WINDOW_SECONDS=300
CPAY_ENVIRONMENT=sandbox
CPAY_COUNTRY=UG
CPAY_CURRENCY=UGX
CPAY_CHANNEL=
CPAY_MINOR_UNIT_EXPONENT=0
CPAY_TIMEOUT_SECONDS=30
CPAY_CONNECT_RETRIES=1
CPAY_RETRY_DELAY_MS=250

# Cito is the preferred third-party services gateway. Leave unset to operate directly.
# During migration these default to CPay values in config when explicitly supplied there.
CITO_BASE_URL=
CITO_MERCHANT_NUMBER=
CITO_PRIVATE_KEY=
CITO_ENVIRONMENT=sandbox
CITO_TIMEOUT_SECONDS=15
# True only after the Cito identity/credit-data routes used by OpFin have completed provider/contract certification.
CITO_FINANCIAL_DATA_CERTIFIED=false

# Optional certified direct money-movement adapters. Class must implement
# App\Contracts\MobileMoneyProviderInterface. Certification remains false until genuinely approved.
MTN_MOBILE_MONEY_ADAPTER_CLASS=
MTN_MOBILE_MONEY_PRODUCTION_CERTIFIED=false
AIRTEL_MOBILE_MONEY_ADAPTER_CLASS=
AIRTEL_MOBILE_MONEY_PRODUCTION_CERTIFIED=false

# Separate, certified CPay messaging endpoint path when CPay is selected for OTP SMS.
# No path is guessed by OpFin.
CPAY_SMS_PATH=
MOCK_MOBILE_MONEY_WEBHOOK_SECRET=

# OTP / security messaging. Production must configure exactly one supported gateway.
SMS_GATEWAY=
YO_SMS_GATEWAY=
YO_SMS_ACCOUNT=
YO_SMS_PASSWORD=

# WhatsApp assisted channel. Required only when the WhatsApp capability is activated.
WHATSAPP_BASE_URL=https://graph.facebook.com/v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Airtel is KYC-only in OpFin. Do not configure payment/disbursement credentials here.
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_BASE_URL=
AIRTEL_COUNTRY=UG
AIRTEL_CURRENCY=UGX

# Credit reference bureau
CRB_URL=
CRB_CLIENT_ID=
CRB_CLIENT_SECRET=
CRB_ENVIRONMENT=production

# Direct identity/biometric evidence provider. In auto mode Cito is primary for NIN and
# phone-ownership capabilities; this endpoint supplies ID-image/selfie liveness/face-match evidence
# that Cito's current signed capability contract does not yet carry. In explicit direct mode it may
# provide the complete identity bundle. Production KYC files must use private persistent/object storage.
IDENTITY_VERIFICATION_URL=
IDENTITY_VERIFICATION_TOKEN=
KYC_FILESYSTEM_DISK=local

# Optional scoring sources. When absent, OpFin records the source as unavailable
# instead of fabricating a score.
MNO_SCORING_URL=
MNO_SCORING_TOKEN=
THIRD_PARTY_SCORING_URL=
THIRD_PARTY_SCORING_TOKEN=

# Assisted channels.
OPFIN_WEB_URL=
USSD_SHARED_SECRET=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=sqlite
# Production must use a dedicated managed PostgreSQL database.
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=opfin_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
SANCTUM_TOKEN_EXPIRY=10080
CORS_ALLOWED_ORIGINS=http://localhost:3000


# UMRA digital-lending controls
OPFIN_LICENSED_ENTITY_NAME=
OPFIN_LICENSED_TRADING_NAME=OpFin
OPFIN_UMRA_LICENSE_NUMBER=
OPFIN_BUSINESS_ADDRESS=
OPFIN_COMPLAINTS_EMAIL=
OPFIN_COMPLAINTS_PHONE=
OPFIN_COMPLAINTS_URL=
# Local/testing may use false. Production boot requires true and offer generation fails closed when the required fields above are missing.
OPFIN_REQUIRE_REGULATED_CREDIT_DISCLOSURE=false
UMRA_COMPLAINT_RESOLUTION_DAYS=30
UMRA_CREDIT_REPORTING_DUE_DAYS=30
UMRA_ENFORCE_NPL_CAP=true

# Outbound positive/negative credit information reporting
CREDIT_REFERENCE_REPORTING_URL=
CREDIT_REFERENCE_REPORTING_TOKEN=
CREDIT_REFERENCE_REPORTING_PROVIDER=

# Financial policy / accounting controls
OPFIN_REGULATORY_LICENCE_CLASS=
OPFIN_REGULATORY_COUNTRY=UG
OPFIN_FEE_RECOGNITION_POLICY_TYPE=credit_fee_recognition
OPFIN_TAX_POLICY_TYPE=tax
# Tax applicability must be explicitly determined before financial UAT/live activation.
# Set true when EFRIS applies. Set false only with OPFIN_EFRIS_DETERMINATION_REFERENCE populated.
OPFIN_EFRIS_REQUIRED=
OPFIN_EFRIS_DETERMINATION_REFERENCE=
OPFIN_EFRIS_ENABLED=false
EFRIS_URL=
EFRIS_TOKEN=
EFRIS_TIN=


# Lightweight location context / Google Maps Platform
# Keep server API keys out of Flutter/Web builds. Location remains foreground/manual only.
GOOGLE_MAPS_PLATFORM_ENABLED=false
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_MAPS_STATIC_MAPS_ENABLED=false
GOOGLE_MAPS_ROUTES_ENABLED=false
