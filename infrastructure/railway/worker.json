{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": [
      "/apps/api/app/**",
      "/apps/api/bootstrap/**",
      "/apps/api/config/**",
      "/apps/api/database/**",
      "/apps/api/lang/**",
      "/apps/api/resources/views/**",
      "/apps/api/routes/**",
      "/apps/api/railway/**",
      "/apps/api/artisan",
      "/apps/api/composer.json",
      "/apps/api/composer.lock",
      "/packages/contracts/**",
      "/infrastructure/railway/worker.json"
    ]
  },
  "deploy": {
    "startCommand": "sh railway/start-worker.sh",
    "numReplicas": 1,
    "sleepApplication": false,
    "restartPolicyType": "ALWAYS"
  }
}
